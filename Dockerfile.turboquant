# Dockerfile.turboquant — CUDA 12 + CPU build
# Uses Ollama's standard build flow: cmake + go build
# Produces a minimal runtime image with ollama binary + CUDA libs

# Stage 1: Build
FROM nvidia/cuda:12.8.0-devel-ubuntu22.04 AS builder

ARG GO_VERSION=1.26.1
RUN apt-get update && apt-get install -y --no-install-recommends \
        wget cmake git gcc g++ ca-certificates && \
    wget -q https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz && \
    tar -C /usr/local -xzf go${GO_VERSION}.linux-amd64.tar.gz && \
    rm go${GO_VERSION}.linux-amd64.tar.gz && \
    rm -rf /var/lib/apt/lists/*
ENV PATH="/usr/local/go/bin:/usr/local/cuda/bin:${PATH}"
ENV CUDA_PATH=/usr/local/cuda
ENV CGO_ENABLED=1

WORKDIR /src
COPY . .

# Ollama build: cmake with full CUDA arch support including Blackwell (SM 120)
RUN cmake -B build \
        -DCMAKE_CUDA_ARCHITECTURES="50;52;60;61;70;75;80;86;89;90;120" && \
    cmake --build build --config Release -j$(nproc) && \
    go build -o ollama .

# Stage 2: Runtime
FROM nvidia/cuda:12.8.0-runtime-ubuntu22.04

COPY --from=builder /src/ollama /usr/local/bin/ollama
COPY --from=builder /src/build/lib/ollama/ /usr/local/lib/ollama/

ENV OLLAMA_HOST=0.0.0.0:11434
ENV LD_LIBRARY_PATH=/usr/local/lib/ollama:${LD_LIBRARY_PATH}

EXPOSE 11434
ENTRYPOINT ["ollama"]
CMD ["serve"]
